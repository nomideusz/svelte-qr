{
  "name": "@nomideusz/svelte-qr",
  "version": "1.0.0",
  "description": "Zero-dependency QR code generation for Svelte 5 — pure TypeScript encoder, SVG output, optional PNG subpath.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./png": {
      "types": "./dist/png/index.d.ts",
      "default": "./dist/png/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit sync && svelte-package",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@types/node": ">=20",
    "sharp": "^0.34.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0-next.3",
    "@sveltejs/adapter-vercel": "7.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.23",
    "@sveltejs/package": "3.0.0-next.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^25.9.4",
    "jsqr": "^1.4.0",
    "marked": "^17.0.6",
    "sharp": "^0.34.5",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "qr",
    "qr-code",
    "svg",
    "zero-dependency",
    "reed-solomon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nomideusz/svelte-qr"
  },
  "homepage": "https://svelte-qr.vercel.app/"
}
