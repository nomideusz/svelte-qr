{
  "name": "@nomideusz/svelte-qr",
  "version": "0.4.0",
  "description": "Zero-dependency QR code generation for Svelte 5 — pure TypeScript encoder, SVG output, optional PNG subpath.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./png": {
      "types": "./dist/png/index.d.ts",
      "default": "./dist/png/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit sync && svelte-package",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "sharp": "^0.34.5",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "jsqr": "^1.4.0",
    "marked": "^17.0.6",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "qr",
    "qr-code",
    "svg",
    "zero-dependency",
    "reed-solomon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nomideusz/svelte-qr"
  },
  "homepage": "https://svelte-qr.vercel.app/"
}
